# =========================================================================
# TRAFIX - Advanced Traffic Police & RTO Management Platform
# Environment Configuration Template
# =========================================================================

# Database Connection (PostgreSQL connection string for Prisma & Pg Pool)
# Example: postgresql://username:password@localhost:5432/trafix_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trafix_db?schema=public"

# Authentication Secret (Used for HMAC SHA-256 JWT Token Generation & Verification)
AUTH_SECRET="TRAFIX_GOVT_SECURE_TOKEN_SECRET_KEY_2026_MORTH_DELHI_POLICE"

# Application Server Port (Defaults to 3000)
PORT=3000

# Environment Mode: development | test | production
NODE_ENV="development"

# Map Tile & GIS Radar Settings
NEXT_PUBLIC_MAP_PROVIDER="openstreetmap"
NEXT_PUBLIC_MAP_KEY=""

# ISRO / NavIC Satellite Telemetry Feed Secret (Optional Mock)
NAVIC_TELEMETRY_KEY="NAVIC_L5_CIP_ENCRYPTED_2026"
